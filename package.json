{
  "name": "uwcourses-web",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "dev": "vite dev",
    "build": "NODE_OPTIONS=--max-old-space-size=6144 vite build",
    "preview": "wrangler dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:browser:setup": "tsx -e \"import setup from './web/tests/browser/setup.ts'; setup()\"",
    "seo:check": "python3 web/seo_audit.py",
    "site:data": "vite build --config web/data.config.ts && node --max-old-space-size=6144 .site/compiler/generate-data.mjs",
    "site:assemble": "node web/assemble-assets.mjs",
    "site:social": "node web/generate-social.mjs",
    "data:import": "uv run --locked uwcourses-site import",
    "assets:check": "uv run --locked uwcourses-site assets-check"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@lucide/svelte": "^1.43.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@tsconfig/svelte": "^5.0.6",
    "@types/cytoscape": "^3.31.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.10.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "ics": "^3.12.0",
    "layerchart": "^2.4.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "5.53.12",
    "svelte-check": "^4.3.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.2.4",
    "vitest": "^3.2.4",
    "wrangler": "^4.129.1"
  },
  "packageManager": "bun@1.4.0",
  "dependencies": {
    "@number-flow/svelte": "^0.4.2",
    "any-ascii": "^0.3.3",
    "bits-ui": "^2.19.0",
    "cytoscape": "^3.34.3",
    "drizzle-orm": "^0.45.2",
    "elkjs": "^0.12.0",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "suncalc": "^2.0.2",
    "unified": "^11.0.5",
    "zod": "^4.5.4"
  }
}
